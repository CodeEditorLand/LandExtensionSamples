{
	"name": "l10n-sample",
	"displayName": "l10n-sample",
	"description": "Sample that shows how to localize an extension",
	"main": "./out/extension.js",
	"scripts": {
		"compile": "tsc -p ./"
	},
	"l10n": "./l10n",
	"contributes": {
		"commands": [
			{
				"command": "extension.sayHello",
				"title": "%extension.sayHello.title%"
			},
			{
				"command": "extension.sayBye",
				"title": "%extension.sayBye.title%"
			}
		]
	},
	"activationEvents": [],
	"dependencies": {
		"@codeeditorland/l10n": "0.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/glob": "^7.2.0",
		"@types/mocha": "^9.1.0",
		"@types/node": "^20",
		"@types/vscode": "^1.73.0",
		"@vscode/l10n-dev": "^0.0.18",
		"@vscode/test-electron": "^2.3.9",
		"eslint": "^9.13.0",
		"glob": "^7.2.0",
		"mocha": "^11.1.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0"
	},
	"dependencies": {
		"@vscode/l10n": "^0.0.10"
	}
}
