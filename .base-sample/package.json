		"lint": "eslint",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@eslint/js": "^9.28.0",
		"@stylistic/eslint-plugin": "^4.4.1",
		"@types/node": "^24",
		"@types/vscode": "1.100.0",
		"eslint": "^9.28.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.34.0"
	}
}